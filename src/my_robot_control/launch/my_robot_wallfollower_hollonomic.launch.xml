<?xml version="1.0"?>
<launch>

    <!-- ========================
         Launch Arguments
         ======================== -->
    <arg name="distance_limit"  default="0.5" />
    <arg name="forward_speed"   default="0.25" />
    <arg name="side_speed"      default="0.20" />
    <arg name="time_to_stop"    default="80.0" />

    <!-- ========================
         Node Definition
         ======================== -->
    <node
        pkg="my_robot_control"
        exec="my_robot_wallfollower_holonomic.py"
        name="wall_follower_holonomic_node"
        output="screen">

        <!-- Parameters -->
        <param name="distance_limit" value="$(var distance_limit)" />
        <param name="forward_speed"  value="$(var forward_speed)" />
        <param name="side_speed"     value="$(var side_speed)" />
        <param name="time_to_stop"   value="$(var time_to_stop)" />
    </node>

</launch>
